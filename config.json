{
  "general": {
    "from": "local",
    "to": "oxibooru"
  },
  "resonite": {
    "photoLocation": "Inventory\\Screenies",
    "photoSystemsLegacy": [
      {
        "triggerTag": "camera_photo",
        "staticTexture2D": ["FrooxEngine.StaticTexture2D", 2],
        "photoMetadata": ["FrooxEngine.PhotoMetadata", 8]
      },
      {
        "triggerTag": "polaroid",
        "staticTexture2D": [4],
        "photoMetadata": [6]
      }
    ]
  },
  "local": {
    "picturesDirectory": "$HOME/Pictures/Resonite",
    "picturesLogFile": "$HOME/Pictures/Resonite.jsonl",
    "videosDirectory": "$HOME/Videos/Resonite",
    "videosLogFile": "$HOME/Videos/Resonite.jsonl",
    "preferredVideoFormat": "webm"
  },
  "oxibooru": {
    "refreshUsernamesInMonths": 2,
    "dangerSettings": "READ DOCS BEFORE TOUCHING!",
    "checkForExistingHashes": true,
    "deleteSourcePictures": false,
    "useCategories": true,
    "useLegacyMigrations": true,
    "categories": {
      "users": "User",
      "host": "SessionHost",
      "accessLevel": "AccessLevel",
      "savedBy": "SavedBy",
      "sessionName": "SessionName",
      "hidden": "HiddenSession",
      "takenBy": "TakenBy",
      "dateTaken": "DateTaken",
      "importerVersion": "ImporterVersion",
      "gameVersion": "GameVersion"
    }
  }
}
